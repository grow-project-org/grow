{
  "name": "plant-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Aplikacja do zarządzania hodowlą roślin — instance-based plant care management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "formik": "^2.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
