  "components": {
    "schemas": {
      "AddEventRequest": {
        "required": [
          "type",
          "executedAt"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/PlantActionType"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AddEventResponse": {
        "required": [
          "plantEventId"
        ],
        "type": "object",
        "properties": {
          "plantEventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreatePlantGroupRequest": {
        "required": [
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/GroupType"
          }
        }
      },
      "CreatePlantGroupResponse": {
        "required": [
          "createdPlantGroupId"
        ],
        "type": "object",
        "properties": {
          "createdPlantGroupId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreatePlantRequest": {
        "required": [
          "customId",
          "specieId"
        ],
        "type": "object",
        "properties": {
          "customId": {
            "type": "string"
          },
          "specieId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreatePlantResponse": {
        "required": [
          "createdPlantId"
        ],
        "type": "object",
        "properties": {
          "createdPlantId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateSpecieRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateSpecieResponse": {
        "required": [
          "specieId"
        ],
        "type": "object",
        "properties": {
          "specieId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateUserRequest": {
        "required": [
          "email",
          "username"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CsrfTokenResponse": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "GroupType": {
        "type": "integer"
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "twoFactorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "twoFactorRecoveryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MeResponse": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        }
      },
      "PlantActionType": {
        "type": "integer"
      },
      "PlantDto": {
        "required": [
          "id",
          "customId",
          "specieId",
          "plantGroupIds",
          "lastExecutions",
          "nextDates"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customId": {
            "type": "string"
          },
          "specieId": {
            "type": "string",
            "format": "uuid"
          },
          "plantGroupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "lastExecutions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "date-time"
            }
          },
          "nextDates": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "PlantGroupDto": {
        "required": [
          "id",
          "name",
          "type",
          "plantIds"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/GroupType"
          },
          "plantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "SpecieDto": {
        "required": [
          "id",
          "name",
          "intervals"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "intervals": {
            "type": "object",
            "additionalProperties": {
              "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
              "type": "string"
            }
          }
        }
      },
      "UpdateIntervalRequest": {
        "required": [
          "interval"
        ],
        "type": "object",
        "properties": {
          "interval": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          }
        }
      }
    }
  },
